# App
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=your-secret-key-here-min-32-chars

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/vector-pilot.db

# OIDC / Keycloak
OIDC_ISSUER_URL=http://localhost:8080/realms/vector-pilot
OIDC_CLIENT_ID=vector-pilot
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=vector-pilot

# LLM Providers
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173